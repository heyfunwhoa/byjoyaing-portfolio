# Create a free API key at https://resend.com/api-keys
# Vercel Production uses the live key. Preview must not reuse it; omit Preview
# or set a separate test key so WIP forms cannot send production mail.
RESEND_API_KEY=re_xxxxxxxxx

# Private inbox that receives contact messages and resume requests
# Do not commit a real personal inbox address to source control.
CONTACT_INBOX=your-private-inbox@example.com

# Optional alias if CONTACT_INBOX is unset
RESUME_INBOX=your-private-inbox@example.com

# Must be a verified sender in Resend.
# Production uses the verified domain mail.byjoyaing.com
RESEND_FROM="Kristen Joy Aing <hello@mail.byjoyaing.com>"

# Selected Work authentication — NOT ACTIVE until implementation is reviewed
# Use a dedicated DEV Neon database. Never paste a real connection string into this file.
AUTH_DATABASE_URL=""
# Generate separately for each environment; random 32+ bytes. Never commit its value.
BETTER_AUTH_SECRET="REPLACE_WITH_SECURE_RANDOM_SECRET"
BETTER_AUTH_URL="http://localhost:3000"
PORTFOLIO_ACCESS_ENABLED="false"

# PostHog errors only. Enable after billing/region/notice review. No real token in git.
NEXT_PUBLIC_POSTHOG_MONITORING_ENABLED="false"
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# Vercel exposes NEXT_PUBLIC_VERCEL_ENV automatically when system vars are enabled.
POSTHOG_MONITORING_ENABLED="false"
POSTHOG_PROJECT_TOKEN=""
POSTHOG_HOST="https://us.i.posthog.com"

# Independent public landing-page analytics. Token alone never enables capture.
# Review notice, billing and synthetic payloads before enabling and rebuilding.
NEXT_PUBLIC_POSTHOG_ANALYTICS_ENABLED="false"

# Optional hosted Keystatic editor. Keep disabled until a GitHub App is installed
# only on heyfunwhoa/byjoyaing-portfolio and callback URLs are configured.
# Set NEXT_PUBLIC_KEYSTATIC_STORAGE=github in the deployment build environment,
# then add the secrets and public App slug in the host dashboard.
# Generate KEYSTATIC_SECRET with at least 32 random characters. Never commit values.
# NEXT_PUBLIC_KEYSTATIC_STORAGE="github"
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG="your-keystatic-github-app-slug"
# KEYSTATIC_GITHUB_CLIENT_ID=""
# KEYSTATIC_GITHUB_CLIENT_SECRET=""
# KEYSTATIC_SECRET=""
